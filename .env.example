# ============================================================
# 制造工艺质量知识图谱平台 - 环境配置（复制为 .env 后按需修改）
# 默认零 Key：mock 规则抽取 + TF-IDF 向量，全链路 1-2 分钟可跑完
# ============================================================

# ---- LLM Chat（OpenAI 兼容接口；无 Key 保持 mock 即可）----
# mock | deepseek | openai（此处 deepseek 含义是"走 OpenAI 兼容协议"，非绑定厂商）
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-在此填入你的密钥
LLM_MODEL=deepseek-chat
# 接入真实模型的实测配置（智谱 GLM-4.5-AIR，免费额度、速度快、JSON 稳定）：
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_API_KEY=你的智谱APIKey
#   LLM_MODEL=glm-4.5-air                      # 备选 glm-4.7；flash 系限流明显
#   DeepSeek 官方：LLM_BASE_URL=https://api.deepseek.com / LLM_MODEL=deepseek-chat
# GLM/deepseek-v4 等推理模型抽取时必须关闭思考：否则思考 token 占满输出，content 返回空
LLM_DISABLE_THINKING=true
LLM_EXTRACT_MAX_TOKENS=16000                  # 通知单条目包 JSON 输出窗口，截断会自动抢救

# ---- Embedding（无 Key 保持 tfidf 离线兜底）----
# tfidf | zhipu | openai | local(bge-small-zh)
EMBEDDING_PROVIDER=tfidf
# 推荐智谱 embedding-3（OpenAI 兼容）：
#   EMBEDDING_PROVIDER=zhipu
#   EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
#   EMBEDDING_API_KEY=你的智谱APIKey
#   EMBEDDING_MODEL=embedding-3
#   EMBEDDING_DIM=2048
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
EMBEDDING_API_KEY=在此填入密钥
EMBEDDING_MODEL=embedding-3
EMBED_DIM=2048

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kg12345678
# Neo4j 连不上时自动降级为内存图库（先跑通全链路，装好 Docker 后自动切回）
GRAPHSTORE_AUTO_FALLBACK=true

# ---- 流水线参数 ----
SEED=42
LLM_CACHE_ENABLED=true
# 节点8批量问答是否调 LLM 生成自然语言（评测只判结构化答案，默认 false 省额度）
QA_LLM_NATURAL=false
# 智谱免费额度建议 3-4（过高触发 429；内置指数退避重试与分段断点续跑）
EXTRACT_CONCURRENCY=4
ALIGN_SIM_THRESHOLD=0.82
CORPUS_SIZE=200
